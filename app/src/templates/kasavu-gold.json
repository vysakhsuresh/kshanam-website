{
  "id": "kasavu-gold",
  "name": "Kasavu Gold",
  "tagline": { "en": "Malayalam + English", "ml": "മലയാളം + ഇംഗ്ലീഷ്" },
  "occasions": ["wedding", "engagement", "save-the-date"],
  "style": "kerala",
  "languages": ["en", "ml", "both"],
  "defaultLanguage": "both",
  "design": { "width": 360, "height": 640 },
  "palette": {
    "bg": "#FFFDF7",
    "gold": "#C9971C",
    "maroon": "#7A1F2B",
    "darkGold": "#8A5A00",
    "ink": "#2A1A1F",
    "muted": "#5E4C51"
  },
  "fonts": { "display": "Marcellus", "ui": "Anek Malayalam", "ml": "Manjari" },
  "slots": {
    "name1": { "label": { "en": "First name", "ml": "ഒന്നാമത്തെ പേര്" }, "default": "Anjali", "maxLength": 24 },
    "name2": { "label": { "en": "Second name", "ml": "രണ്ടാമത്തെ പേര്" }, "default": "Rahul", "maxLength": 24 },
    "dateLong": { "derived": "date", "default": "Sunday, 14 February 2027" },
    "timeText": { "derived": "time", "default": "Muhurtham 10:30 AM" },
    "venue": { "label": { "en": "Venue", "ml": "സ്ഥലം" }, "default": "Kalyana Mandapam, Thrissur", "maxLength": 90 },
    "customLine": { "label": { "en": "One more line (optional)", "ml": "ഒരു വരി കൂടി (ഐച്ഛികം)" }, "default": "", "maxLength": 70 }
  },
  "photoSlot": { "shape": "rect", "hint": { "en": "A photo of the couple", "ml": "ദമ്പതികളുടെ ഫോട്ടോ" } },
  "music": "veena-soft",

  "background": [
    { "type": "rect", "x": 0, "y": 0, "w": 360, "h": 640, "fill": "@bg" },
    { "type": "rect", "x": 0, "y": 0, "w": 360, "h": 22, "fill": "@gold", "anchorY": 0,
      "anim": { "in": { "preset": "grow-height", "dur": 0.7, "ease": "outCubic" } } },
    { "type": "rect", "x": 0, "y": 22, "w": 360, "h": 4, "fill": "@maroon", "anchorY": 0,
      "anim": { "in": { "preset": "grow-height", "at": 0.1, "dur": 0.7 } } },
    { "type": "rect", "x": 0, "y": 618, "w": 360, "h": 22, "fill": "@gold", "anchorY": 640,
      "anim": { "in": { "preset": "grow-height", "dur": 0.7 } } },
    { "type": "rect", "x": 0, "y": 614, "w": 360, "h": 4, "fill": "@maroon", "anchorY": 640,
      "anim": { "in": { "preset": "grow-height", "at": 0.1, "dur": 0.7 } } },
    { "type": "border", "x": 18, "y": 40, "w": 324, "h": 560, "radius": 6, "stroke": "@gold",
      "width": 1, "anim": { "in": { "preset": "fade", "at": 0.5, "dur": 1 } } }
  ],

  "scenes": [
    {
      "id": "title",
      "duration": 5,
      "fadeOut": 0.5,
      "layers": [
        { "type": "icon", "name": "lamp", "x": 180, "y": 252, "size": 66, "stroke": "@gold",
          "width": 1.5, "anim": { "in": { "preset": "scale-in", "at": 0.5, "dur": 0.9 } } },
        { "type": "text", "modes": ["ml", "both"], "text": "വിവാഹ ക്ഷണം", "font": "ml",
          "size": 32, "color": "@darkGold", "x": 180, "y": 342, "maxWidth": 280,
          "anim": { "in": { "preset": "fade-up", "at": 1.1, "dur": 0.8 } } },
        { "type": "text", "modes": ["both"], "text": "Wedding Invitation", "font": "ui",
          "size": 13, "letterSpacing": 2.6, "uppercase": true, "color": "@darkGold",
          "x": 180, "y": 380, "maxWidth": 280,
          "anim": { "in": { "preset": "fade-up", "at": 1.45, "dur": 0.8 } } },
        { "type": "text", "modes": ["en"], "text": "Wedding Invitation", "font": "ui",
          "size": 19, "letterSpacing": 3.4, "uppercase": true, "color": "@darkGold",
          "x": 180, "y": 348, "maxWidth": 290,
          "anim": { "in": { "preset": "fade-up", "at": 1.1, "dur": 0.8 } } },
        { "type": "icon", "name": "flourish", "x": 180, "y": 420, "size": 11, "stroke": "@gold",
          "width": 1.1, "anim": { "in": { "preset": "fade", "at": 1.8, "dur": 0.8 } } }
      ]
    },
    {
      "id": "intro",
      "duration": 4,
      "fadeOut": 0.5,
      "layers": [
        { "type": "text",
          "text": {
            "en": "Together with our families, we invite you to the wedding of",
            "ml": "ഞങ്ങളുടെ കുടുംബങ്ങളോടൊപ്പം നിങ്ങളെ ക്ഷണിക്കുന്നു"
          },
          "font": "ui", "size": 19, "color": "@muted", "x": 180, "y": 320,
          "maxWidth": 266, "maxLines": 4, "lineHeight": 1.45,
          "anim": { "in": { "preset": "fade-up", "at": 0.2, "dur": 0.8 } } }
      ]
    },
    {
      "id": "names",
      "duration": 6,
      "fadeOut": 0.5,
      "layers": [
        { "type": "text", "text": "{{name1}}", "font": "display", "size": 54, "color": "@maroon",
          "x": 180, "y": 282, "maxWidth": 292, "minSize": 28,
          "anim": { "in": { "preset": "fade-up", "at": 0.15, "dur": 0.9 } } },
        { "type": "text", "text": "&", "font": "display", "size": 26, "color": "@darkGold",
          "x": 180, "y": 328,
          "anim": { "in": { "preset": "scale-in", "at": 0.55, "dur": 0.7 } } },
        { "type": "text", "text": "{{name2}}", "font": "display", "size": 54, "color": "@maroon",
          "x": 180, "y": 374, "maxWidth": 292, "minSize": 28,
          "anim": { "in": { "preset": "fade-up", "at": 0.85, "dur": 0.9 } } },
        { "type": "line", "x1": 150, "y1": 418, "x2": 210, "y2": 418, "stroke": "@gold",
          "width": 1, "anchorX": 180, "anchorY": 418,
          "anim": { "in": { "preset": "grow-width", "at": 1.4, "dur": 0.8 } } }
      ]
    },
    {
      "id": "when",
      "duration": 5,
      "fadeOut": 0.5,
      "layers": [
        { "type": "text", "text": { "en": "Date", "ml": "തീയതി" }, "font": "ui", "size": 12,
          "letterSpacing": 2.6, "uppercase": true, "color": "@darkGold", "x": 180, "y": 268,
          "anim": { "in": { "preset": "fade", "at": 0.15, "dur": 0.6 } } },
        { "type": "text", "text": "{{dateLong}}", "font": "ui", "weight": 600, "size": 26,
          "color": "@ink", "x": 180, "y": 312, "maxWidth": 292, "maxLines": 2, "lineHeight": 1.25,
          "minSize": 16, "anim": { "in": { "preset": "fade-up", "at": 0.35, "dur": 0.9 } } },
        { "type": "text", "text": "{{timeText}}", "font": "ui", "size": 19, "color": "@muted",
          "x": 180, "y": 368, "maxWidth": 292, "maxLines": 2, "lineHeight": 1.3,
          "anim": { "in": { "preset": "fade-up", "at": 0.8, "dur": 0.9 } } }
      ]
    },
    {
      "id": "where",
      "duration": 5,
      "fadeOut": 0.5,
      "layers": [
        { "type": "text", "text": { "en": "Venue", "ml": "സ്ഥലം" }, "font": "ui", "size": 12,
          "letterSpacing": 2.6, "uppercase": true, "color": "@darkGold", "x": 180, "y": 272,
          "anim": { "in": { "preset": "fade", "at": 0.15, "dur": 0.6 } } },
        { "type": "text", "text": "{{venue}}", "font": "ui", "weight": 500, "size": 23,
          "color": "@ink", "x": 180, "y": 326, "maxWidth": 286, "maxLines": 3, "lineHeight": 1.35,
          "minSize": 15, "anim": { "in": { "preset": "fade-up", "at": 0.35, "dur": 0.9 } } }
      ]
    },
    {
      "id": "photo",
      "duration": 3.5,
      "requires": "photo",
      "fadeOut": 0.5,
      "layers": [
        { "type": "photo", "x": 92, "y": 196, "w": 176, "h": 236, "radius": 4, "stroke": "@gold",
          "width": 1, "anchorX": 180, "anchorY": 314,
          "anim": { "in": { "preset": "scale-in", "at": 0.1, "dur": 0.9 } } }
      ]
    },
    {
      "id": "blessing",
      "duration": 4.5,
      "fadeOut": 0.6,
      "layers": [
        { "type": "text",
          "text": {
            "en": "Your presence is our blessing",
            "ml": "നിങ്ങളുടെ സാന്നിധ്യം ഞങ്ങളുടെ അനുഗ്രഹം"
          },
          "font": "display", "size": 24, "color": "@maroon", "x": 180, "y": 300,
          "maxWidth": 280, "maxLines": 3, "lineHeight": 1.35, "minSize": 16,
          "anim": { "in": { "preset": "fade-up", "at": 0.2, "dur": 0.9 } } },
        { "type": "text", "text": "{{customLine}}", "font": "ui", "size": 17, "color": "@muted",
          "x": 180, "y": 364, "maxWidth": 280, "maxLines": 2, "lineHeight": 1.4,
          "anim": { "in": { "preset": "fade-up", "at": 0.6, "dur": 0.9 } } },
        { "type": "icon", "name": "lamp", "x": 180, "y": 428, "size": 46, "stroke": "@gold",
          "width": 1.4, "anim": { "in": { "preset": "fade", "at": 0.9, "dur": 0.9 } } }
      ]
    }
  ]
}
